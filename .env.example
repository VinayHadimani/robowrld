# ── Supabase (required for cloud mode) ──────────────────────────────
# Project URL: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# service_role key — SERVER-SIDE ONLY, never expose to the client.
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Local Prisma fallback (optional) ────────────────────────────────
# SQLite file used by the packs fallback store when Supabase tables
# are not reachable. Safe to leave at the default.
DATABASE_URL=file:./db/custom.db
